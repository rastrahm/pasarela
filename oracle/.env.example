# Oracle de Autorización — variables de entorno
# Copiar a .env y ajustar valores locales. NUNCA commitear .env con secretos reales.

# Servidor
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8081
RUST_LOG=oracle_authorization=info,tower_http=info

# Seguridad — fail closed si faltan en producción
ORACLE_API_KEY=change-me-use-high-entropy-secret
ORACLE_ALLOWED_CALLERS=127.0.0.1,172.17.0.0/16

# Rate limiting
ORACLE_RATE_LIMIT_PER_MINUTE=100

# Timeouts (segundos) para consultas a rieles externos
ORACLE_RAIL_TIMEOUT_SECS=5

# Holds
ORACLE_HOLD_TTL_SECS=300

# Riel Binance — spread buffer (decisión D4: configurable por entorno)
BINANCE_SPREAD_BUFFER_PCT=0.02

# Servicio antifraude simulado (decisión D11)
ANTIFRAUD_BASE_URL=http://127.0.0.1:8082
ANTIFRAUD_API_KEY=change-me-antifraud-key
