//! Oracle de Autorización — variables de entorno
# Copiar a .env y ajustar valores locales. NUNCA commitear .env con secretos reales.

# Servidor
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8081
RUST_LOG=oracle_authorization=info,tower_http=info

# Base de datos PostgreSQL (localhost)
ORACLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/oracle

# Seguridad — fail closed si faltan en producción
ORACLE_API_KEY=change-me-use-high-entropy-secret
ORACLE_ALLOWED_CALLERS=127.0.0.1,172.17.0.0/16

# Rate limiting
ORACLE_RATE_LIMIT_PER_MINUTE=100

# Timeouts (segundos) para consultas a rieles externos
ORACLE_RAIL_TIMEOUT_SECS=5

# Holds
ORACLE_HOLD_TTL_SECS=300
ORACLE_TTL_CLEANUP_INTERVAL_SECS=60

# Saldos simulados por riel (fondos disponibles para el cliente)
TRADITIONAL_BANK_BALANCE=10000
BINANCE_CEX_BALANCE=5000
SOLANA_WALLET_BALANCE=2500

# Riel Binance — spread buffer (decisión D4: configurable por entorno)
BINANCE_SPREAD_BUFFER_PCT=0.02

# API Spot simulada (microservicio binance-sim/ en :8083)
BINANCE_CEX_BASE_URL=http://127.0.0.1:8083
# Debe coincidir con BINANCE_CEX_API_KEY en binance-sim/.env
BINANCE_CEX_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Riel Solana — balance SPL vía JSON-RPC
# Local validator (desarrollo):
SOLANA_RPC_URL=http://127.0.0.1:8899
# Devnet (staging — ver programs/payment-settlement/deploy/devnet.json):
# SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PUBKEY=DemoWallet1111111111111111111111111111111
# Mint USDC mainnet (ajustar en devnet/staging)
SOLANA_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Programa Anchor payment-settlement (Fase 3.9 — Gateway Fase 4)
# PAYMENT_SETTLEMENT_PROGRAM_ID=4cKoeammHN8UjAbiJRw2DqxBPL1Mb1EaPQeJFFuo564B

# Servicio antifraude simulado (decisión D11)
ANTIFRAUD_BASE_URL=http://127.0.0.1:8082
# Debe coincidir con ANTIFRAUD_API_KEY en antifraud/.env
ANTIFRAUD_API_KEY=change-me-generate-with-openssl-rand-hex-32
ANTIFRAUD_TIMEOUT_SECS=5
