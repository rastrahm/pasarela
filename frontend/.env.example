# =============================================================================
# Frontend — variables de entorno (Vite)
# =============================================================================
# Uso:
#   cp .env.example .env.local
#   pnpm dev
#
# Solo variables con prefijo VITE_ se exponen al bundle del navegador.
# Nunca commitear .env.local (gitignore).

# URL pública del API Gateway (sin barra final).
# Debe apuntar al servicio levantado con `cargo run -p api-gateway`.
# Default alineado con GATEWAY_PORT=8080 en crates/api-gateway/.env.example
VITE_API_BASE_URL=http://127.0.0.1:8080

# API key del comercio — header Authorization: Bearer sk_* (decisión D12).
# DEBE coincidir con GATEWAY_TEST_API_KEY del Gateway:
#   crates/api-gateway/.env  →  GATEWAY_TEST_API_KEY=...
VITE_GATEWAY_API_KEY=sk_test_change_me_32chars_min
