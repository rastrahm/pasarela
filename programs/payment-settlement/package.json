{
  "license": "ISC",
  "scripts": {
    "build": "anchor build --no-idl -- --tools-version v1.52 && anchor idl build -o target/idl/payment_settlement.json -t target/types/payment_settlement.ts",
    "test": "npm run build && anchor test --skip-build",
    "test:ci": "bash scripts/ci-test.sh",
    "deploy:devnet": "npm run build && anchor deploy --provider.cluster devnet",
    "verify:devnet": "bash scripts/verify-devnet.sh",
    "lint:docs": "bash scripts/check-instruction-docs.sh",
    "test:only": "ts-mocha -p ./tsconfig.json -t 1000000 tests/payment-settlement.ts tests/settlement-state.ts tests/process-payment.ts tests/process-payment-constraints.ts",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "8.3.2"
    }
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.13",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.2.2",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
