//! Binance Spot simulado — variables de entorno
# Copiar a .env y ajustar valores locales. NUNCA commitear .env con secretos reales.

BINANCE_SIM_HOST=0.0.0.0
BINANCE_SIM_PORT=8083
RUST_LOG=binance_sim_service=info

# Debe coincidir con BINANCE_CEX_API_KEY en oracle/.env
BINANCE_CEX_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Saldo Spot por defecto (USDC/USDT/USD)
BINANCE_CEX_BALANCE=5000

# Opcional: saldos por moneda — USDC=5000,USDT=4800
# BINANCE_CEX_BALANCES=USDC=5000,USDT=4800
