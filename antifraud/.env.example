# Servicio antifraude simulado — variables de entorno

ANTIFRAUD_HOST=0.0.0.0
ANTIFRAUD_PORT=8082
RUST_LOG=antifraud_service=info,tower_http=info

# Debe coincidir con ANTIFRAUD_API_KEY en oracle/.env
ANTIFRAUD_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Reglas de scoring
ANTIFRAUD_MAX_AMOUNT=50000
ANTIFRAUD_DECLINE_SCORE_THRESHOLD=0.85
ANTIFRAUD_BLOCKED_TOKEN_HASHES=
