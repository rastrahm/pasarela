# Frontend estático + Caddy (TLS / reverse proxy al Gateway) — Fase 7.

FROM node:20-bookworm AS frontend

WORKDIR /app/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY frontend ./

ARG VITE_API_BASE_URL
ARG VITE_GATEWAY_API_KEY

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_GATEWAY_API_KEY=${VITE_GATEWAY_API_KEY}

RUN pnpm build

FROM caddy:2-alpine

COPY deploy/staging/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend /app/frontend/dist /srv/frontend

EXPOSE 80 443
